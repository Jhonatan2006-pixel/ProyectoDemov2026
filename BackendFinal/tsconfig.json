{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "main.ts", "maint.ts"],
  "exclude": [
    "src/application_use_cases",
    "src/infrastructure/repositories"
  ]
}