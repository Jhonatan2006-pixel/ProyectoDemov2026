# Copiar este archivo como ".env" y completar los valores.
# El archivo .env no se sube al repositorio porque contiene claves.

# Motor de base de datos: mssql (SQL Server) o postgres (PostgreSQL)
DB_DIALECT=mssql
DB_NAME=TaskFlowDB
DB_USER=appuser
DB_PASSWORD=escribe_aqui_la_clave_de_la_base
DB_HOST=localhost
DB_PORT=1433

# Puerto en el que escucha el backend
PORT=3000

# Clave con la que se firman los tokens de sesion (JWT)
JWT_SECRET=escribe_aqui_una_clave_larga_y_al_azar

# Codigo que pide la app para registrarse como administrador
ADMIN_CODE=escribe_aqui_el_codigo_de_administrador

# Opcional: "false" para no mostrar cada consulta SQL en la consola
# DB_LOGGING=false
